   "dur": 2.352
  },
  "f:drill_fast_tail": {
   "id": "54715e7a24",
   "file": "clips/54715e7a24.mp3",
   "text": "走一遍，或者换一首更难的。",
   "dur": 2.424
  },
  "f:drill_metronome": {
   "id": "6974e92a34",
   "file": "clips/6974e92a34.mp3",
   "text": "开着节拍器再走一遍，后半段刻意压住，听见节拍器再落键，不要往前赶。",
   "dur": 6.6
  },
  "f:drill_count": {
   "id": "2903b4fb76",
   "file": "clips/2903b4fb76.mp3",
   "text": "先不弹，跟着节拍器把整首的拍子拍一遍，再回琴上弹。",
   "dur": 4.92
  },
  "f:drill_dynamics": {
   "id": "79c217cbb2",
   "file": "clips/79c217cbb2.mp3",
   "text": "单独练一遍力度，每个音都弹到底，强的地方真强。",
   "dur": 4.128
  },
  "f:drill_extras": {
   "id": "43c22b8fa4",
   "file": "clips/43c22b8fa4.mp3",
   "text": "一直有多余的音混进来，注意把手放松，弹完及时离键。",
   "dur": 4.2
  },
  "f:drill_slow_head": {
   "id": "7a90f25c56",
   "file": "clips/7a90f25c56.mp3",
   "text": "先把速度降到",
   "dur": 1.2
  },
  "f:drill_slow_tail": {
   "id": "3bbb303875",
   "file": "clips/3bbb303875.mp3",
   "text": "，整首再走一遍，只求把每个音弹准。",
   "dur": 3.12
  },
  "f:next_perfect": {
   "id": "9f752a5ea6",
